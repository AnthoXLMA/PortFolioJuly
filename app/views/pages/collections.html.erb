<head>
  <!-- Import de la police moderne -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<section class="photo-row-container">
  <header class="photo-row-header">
    <h2 class="photo-row-title">Collections</h2>
  </header>

  <div class="photo-row-horizontal">
    <% collections = [
      { url: "https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_800/v1752672208/Brittany/IMG_8867_-_Grande_esfl2c.jpg", path: "/brittany" },
      { url: "https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_800/v1754507830/NewYork/IMG_4369_-_Grande_wm3ioq.jpg", path: "/new_york" },
      { url: "https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_800/v1752423661/Brittany/IMG_8190_-_Grande_sb7nvh.jpg", path: "/brittany" },
      { url: "https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_800/v1754553768/NewYork/_MG_1957_-_Grande_m55stb.jpg", path: "/new_york" },
      { url: "https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_800/v1754554095/NewYork/IMG_8434_-_Moyenne_ocb3iu.jpg", path: "/new_york" }
    ] %>

    <% collections.each do |photo| %>
      <%= link_to image_tag(photo[:url], class: "photo-item-horizontal", alt: "Collection photo"), photo[:path] %>
    <% end %>
  </div>

  <nav class="photo-row-menu" aria-label="Collection categories">
    <ul>
      <li><%= link_to "Silent Horizons", "/silenthorizons" %></li>
      <li><%= link_to "Willow & Stone", "/willow_and_stone" %></li>
      <li><%= link_to "Metropolitan", "/metropolitan" %></li>
      <li><%= link_to "Velvet Reverie", "/velvetreverie" %></li>
    </ul>
  </nav>
</section>

<!-- ===== GALERIE ARTISTIQUE : LIFESTYLES & OUTDOORS ===== -->
<section class="art-gallery">
  <header class="gallery-header">
    <h2>Lifestyles & Outdoors</h2>
    <p>Fragments du mouvement, de la respiration et de la lumière.</p>
  </header>

  <div class="gallery-pair">
    <figure class="gallery-item">
      <%= image_tag("https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_1000/v1754776391/Sportts/IMG_0335_-_Grande_rb8mc9.jpg", class: "gallery-photo", alt: "Stadium photo") %>
      <figcaption>
        <h3>Stadium</h3>
        <p>De la tension sportive à la géométrie des gradins.</p>
        <%= link_to "Explorer la série →", "/lifestyles", class: "gallery-link" %>
      </figcaption>
    </figure>

    <figure class="gallery-item">
      <%= image_tag("https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_1000/v1752512083/Snow/IMG_4570_sdl3lk.jpg", class: "gallery-photo", alt: "Courchevel snow scene") %>
      <figcaption>
        <h3>La Rosière</h3>
        <p>La blancheur devient matière, silence et ligne d’horizon.</p>
        <%= link_to "Explorer la série →", "/interiors", class: "gallery-link" %>
      </figcaption>
    </figure>
  </div>
</section>

<!-- ===== GALERIE ARTISTIQUE : URBAINES & PAYSAGES ===== -->
<section class="art-gallery">
  <header class="gallery-header">
    <h2>Urban & Spiritual Landscapes</h2>
    <p>La ville et le souffle du monde, entre pierres et lumière.</p>
  </header>

  <div class="gallery-pair">
    <figure class="gallery-item">
      <%= image_tag("https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_1000/v1752767761/Paris/IMG_5619_-_Grande_ifwk1l.jpg", class: "gallery-photo", alt: "Rivoli streetscape") %>
      <figcaption>
        <h3>Rivoli</h3>
        <p>Une traversée de la pierre, de la mode et du passage.</p>
        <%= link_to "Voir la collection →", "/commercials", class: "gallery-link" %>
      </figcaption>
    </figure>

    <figure class="gallery-item">
      <%= image_tag("https://res.cloudinary.com/dqaturjpm/image/upload/f_auto,q_auto,w_1000/v1752511599/IMG_5246_l0vdc4.jpg", class: "gallery-photo", alt: "Madrugada ambiance") %>
      <figcaption>
        <h3>Madrugada</h3>
        <p>L’heure bleue où les contours se dissolvent dans l’ombre.</p>
        <%= link_to "Voir la série →", "/spirituals", class: "gallery-link" %>
      </figcaption>
    </figure>
  </div>
</section>


<script>
  // Apparition fluide au scroll
  document.addEventListener("scroll", () => {
    document.querySelectorAll(".photo-item-horizontal, .photo-item-1").forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight - 100) {
        el.classList.add("visible");
      }
    });
  });

  // Scroll horizontal fluide avec la molette
  const scroller = document.querySelector(".photo-row-horizontal");
  scroller.addEventListener("wheel", (evt) => {
    evt.preventDefault();
    scroller.scrollLeft += evt.deltaY;
  });
</script>

<style>
  body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background-color: white;
  }

  /* SECTION HORIZONTALE */
  .photo-row-container {
    position: relative;
    overflow: hidden;
    width: 100%;
/*    height: 400px;
*/    margin-bottom: 80px;
  }

  .photo-row-header {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  .photo-row-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    letter-spacing: 1px;
    text-align: center;
    pointer-events: none;
    user-select: none;
  }

  .photo-row-horizontal {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    height: 90%;
    width: 100%;
    position: relative;
    scroll-snap-type: x mandatory;
  }

  .photo-row-horizontal::-webkit-scrollbar {
    display: none;
  }

  .photo-item-horizontal {
    flex: 0 0 auto;
    width: 400px;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: start;
    transition: transform 0.4s ease, filter 0.4s ease;
    opacity: 0;
    transform: translateY(30px);
    z-index: 1;
  }

  .photo-item-horizontal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-item-horizontal:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .photo-row-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55), rgba(0,0,0,0.1));
    z-index: 2;
    pointer-events: none;
  }

  /* MENU OVERLAY */
  .photo-row-menu {
    position: absolute;
    bottom: 15px;
    left: 20px;
    z-index: 20;
  }

  .photo-row-menu ul {
    list-style: none;
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
  }

  .photo-row-menu a {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    color: white;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: 4px;
    background-color: rgba(255,255,255,0.15);
    transition: background 0.3s ease, color 0.3s ease;
  }

  .photo-row-menu a:hover {
    background-color: rgba(255,255,255,0.35);
    color: #A1866F;
  }

  /* AUTRES BLOCS */
  .container-2-3-wrapper {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    margin: 40px auto;
    gap: 20px;
    max-width: 1100px;
    padding: 0 20px;
  }

  .container-2, .container-3 {
    flex: 1 1 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .photo-item-1 {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.25);
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .photo-item-1.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-item-1:hover {
    transform: scale(1.02);
  }

  .image-caption {
    margin-top: 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    color: #666;
    text-align: center;
  }



/* ====== SECTION ART GALLERY ====== */
.art-gallery {
  max-width: 1200px;
  margin: 80px auto;
  padding: 0 20px;
  font-family: 'Poppins', sans-serif;
}

.gallery-header {
  text-align: center;
  margin-bottom: 40px;
}

.gallery-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 500;
  margin-bottom: 10px;
  letter-spacing: 1px;
  color: #111;
}

.gallery-header p {
  color: #555;
  font-size: 1rem;
  font-weight: 300;
}

.gallery-pair {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
  gap: 40px;
}

.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 12px 28px rgba(0,0,0,0.15);
  background: #fff;
  transition: transform 0.5s ease, box-shadow 0.4s ease;
}

.gallery-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}

.gallery-photo {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.gallery-item:hover .gallery-photo {
  transform: scale(1.05);
}

figcaption {
  padding: 20px 25px 25px;
  text-align: left;
}

figcaption h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  margin-bottom: 5px;
  color: #222;
}

figcaption p {
  font-size: 0.95rem;
  color: #666;
  margin-bottom: 15px;
  font-weight: 300;
}

.gallery-link {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 500;
  text-transform: uppercase;
  color: #111;
  border-bottom: 1px solid #111;
  letter-spacing: 0.05em;
  transition: color 0.3s, border-color 0.3s;
}

.gallery-link:hover {
  color: #a1866f;
  border-color: #a1866f;
}

/* Responsive */
@media (max-width: 768px) {
  .gallery-header h2 { font-size: 2rem; }
  .gallery-pair { gap: 25px; }
  figcaption { padding: 15px; }
}




  /* RESPONSIVE */
  @media (max-width: 768px) {
    .photo-row-container {
      height: 300px;
    }

    .photo-item-horizontal {
      width: 250px;
    }

    .photo-row-menu ul {
      flex-direction: column;
      gap: 6px;
    }

    .photo-row-title {
      font-size: 2.5rem;
    }
  }
</style>
