<section class="resume">
  <div class="slideshow-container relative w-full h-[90vh] overflow-hidden">
    <% images = [
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1752767761/Paris/IMG_5619_-_Grande_ifwk1l.jpg",
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1754573100/Brittany/IMG_9644_-_Grande_pmv1cs.jpg",
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1754557549/NewYork/IMG_4572_-_Grande_rlhq4a.jpg"
    ] %>

    <!-- Background fallback pour éviter le noir -->
    <div class="slideshow-background absolute inset-0 bg-gray-900"></div>

    <% images.each_with_index do |img, index| %>
      <div class="mySlides absolute inset-0 transition-opacity duration-1000 ease-in-out <%= index.zero? ? 'active' : '' %>">
        <%= image_tag(img, alt: "Photo #{index + 1}", class: "w-full h-full object-cover") %>
      </div>
    <% end %>

    <!-- Navigation -->
    <a class="prev absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl font-bold cursor-pointer" onclick="plusSlides(-1)">&#10094;</a>
    <a class="next absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl font-bold cursor-pointer" onclick="plusSlides(1)">&#10095;</a>
  </div>
</section>

<section class="gallery-section">
  <div style="margin-bottom: 20px;">
    <h1><%= link_to "Découvrez toutes les photos", fragments_path %></h1>
  </div>
  <div class="grid-gallery">
    <% [
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1752767811/Paris/IMG_5144_-_Grande_ogstwo.jpg",
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1752767790/Paris/IMG_5541_-_Grande_acpuvp.jpg",
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1752767801/Paris/IMG_5418_-_Grande_qvi3cw.jpg",
      "https://res.cloudinary.com/dqaturjpm/image/upload/v1752767761/Paris/IMG_5619_-_Grande_ifwk1l.jpg"
    ].each do |img_url| %>
      <div>
        <%= image_tag img_url, alt: "Titre de l’image" %>
      </div>
    <% end %>
  </div>
</section>

<script>
  let slideIndex = 0;
  const slides = document.getElementsByClassName("mySlides");
  let slideInterval;

  function showSlides(n) {
    for (let i = 0; i < slides.length; i++) slides[i].classList.remove("active");
    slides[n].classList.add("active");
  }

  function plusSlides(n) {
    slideIndex = (slideIndex + n + slides.length) % slides.length;
    showSlides(slideIndex);
    resetInterval();
  }

  function startSlides() {
    slideInterval = setInterval(() => {
      slideIndex = (slideIndex + 1) % slides.length;
      showSlides(slideIndex);
    }, 4000);
  }

  function resetInterval() {
    clearInterval(slideInterval);
    startSlides();
  }

  document.addEventListener("DOMContentLoaded", () => {
    showSlides(slideIndex);
    startSlides();
  });
</script>

<style>
  body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .resume {
    padding: 0;
    width: 100%;
    height: auto;
    background-color: black;
  }

  .slideshow-background {
    z-index: 0;
    background-color: #111;
  }

  .slideshow-container {
    position: relative;
    width: 100%;
    height: 70vh;
    overflow: hidden;
  }

  .mySlides {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 1;
    transition: opacity 1.5s ease-in-out;
  }

  .mySlides.active {
    opacity: 1;
    z-index: 2;
  }

  .intrigue-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.2));
  }

  .gallery-section {
    padding: 40px;
    background: white;
    text-align: center;
  }

  .grid-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .grid-gallery img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .grid-gallery img:hover {
    transform: scale(1.03);
  }

  .prev, .next {
    z-index: 4;
    user-select: none;
    transition: opacity 0.3s;
  }

  .prev:hover, .next:hover {
    opacity: 0.7;
  }
</style>
